# deps / build
node_modules/
dist/
.playwright-cli/

# secrets & live sessions — NEVER commit
.env
**/auth.json
**/auth.meta.json

# runtime artifacts
.bro/
*.log

# private site definitions — the list of vendors is itself sensitive.
# Only the committed template (_example) is public.
sites/*
!sites/_example/
!sites/_example/**

# Personal scratch scripts live in local/ -- see local/README.md. That folder has
# its own .gitignore keeping everything but the README, so a clone gets a usable
# scratch space without carrying anyone else's one-offs. This repo is PUBLIC and
# bro is a workflow runner, not a scraper library.
# Belt-and-braces: catch scratch scripts dropped at the root out of habit.
scrape-*.mjs
diag-*.mjs
search-web.mjs

# OS
.DS_Store
Thumbs.db

# bim-bro driver build artifacts (regenerate with `npm run build:driver`)
bim-bro.exe
sea/sea-prep.blob
sea/sea-config.json
sea/launcher.build.cjs
sea/driver.bundle.cjs
profiles/
