# bro configuration — copy to .env and fill in. .env is gitignored; never commit real values.

# Output sink: local | drive-raw
BRO_SINK=local

# local sink root (the accounting cache tree). {YYYY}/{MM}/{source}/ is created under this.
BRO_LOCAL_ROOT=H:/working/assistant/shared_accounting_data

# drive-raw sink: the Drive folder id that raw/{YYYY}/{MM}/{source} lives under.
# (Requires the bim-cli drive-upload enhancement — see README.)
ASSIST_RAW_DRIVE_FOLDER=

# Playwright browser channel: msedge (Windows default) | chrome | chromium
BRO_BROWSER_CHANNEL=msedge

# Optional: keep your private site definitions outside the repo.
# BRO_SITES_DIR=H:/working/bro-sites-private
